# Server
PORT=4000
CORS_ORIGINS=http://localhost:3000

# MySQL (Prisma). Create the database first: CREATE DATABASE dr_prema CHARACTER SET utf8mb4;
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/dr_prema"

# Auth — use a long random value (at least 32 chars): openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Used only by `npm run db:seed` to create the first admin (password: 12+ chars)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Dr Prema Admin
